    else:
        cached = load_ranges()
        if cached is None:
            die("card is suspended and no cached range is available; run a workload once so the watcher can record the live range, then retry")
        if watts < cached["cap_min_w"] or watts > cached["cap_max_w"]:
            die(f"{watts} W outside cached range {cached['cap_min_w']:.0f}..{cached['cap_max_w']:.0f} W")
        log(f"set-power-cap: validated against cached range {cached['cap_min_w']:.0f}..{cached['cap_max_w']:.0f} W")
    # Runtime-PM write guard: die before touching the config file.
    try:
