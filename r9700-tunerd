_HEX_RE = re.compile(r"^0x[0-9a-f]{4}$")

_stop = False
_last_pm_refusal: str | None = None
_last_kernel_scan = 0.0


def _stderr_is_journal() -> bool:
    """True only when stderr really is the systemd journal stream.

    systemd exports JOURNAL_STREAM="<st_dev>:<st_ino>" of the stream it gave
    the service. The variable is inherited by every descendant (a terminal
    started from a systemd user service still carries it), so the presence
    of the variable alone is not proof; compare it with our actual fd 2.
    """
    js = os.environ.get("JOURNAL_STREAM")
    if not js:
        return False
    try:
        dev, ino = js.split(":", 1)
        st = os.fstat(2)
        return st.st_dev == int(dev) and st.st_ino == int(ino)
    except (ValueError, OSError):
        return False


def log(msg: str, level: int = syslog.LOG_INFO) -> None:
    syslog.syslog(level, msg)
    if level == syslog.LOG_INFO:
        # INFO: visible on a terminal; suppressed under the journal to avoid
        # duplicating lines that syslog already captured.
        if sys.stdout.isatty():
            print(msg, flush=True)
    else:
        # WARNING / ERR: must be visible to calling scripts even when stdout
        # is not a TTY.  When stderr is the systemd journal stream the syslog
        # call already lands in the journal, so printing would duplicate it.
        if not _stderr_is_journal():
            print(msg, file=sys.stderr, flush=True)


def die(msg: str, code: int = 1) -> None:
    log(msg, syslog.LOG_ERR)
    sys.exit(code)


def read_text(path: Path) -> str:
    return path.read_text(encoding="utf-8", errors="replace").strip()


def write_text(path: Path, value: str) -> None:
    """Write value to path, looping until all bytes are written."""
    data = value.encode("utf-8")
    fd = os.open(path, os.O_WRONLY | os.O_CLOEXEC)
    try:
        off = 0
        while off < len(data):
            n = os.write(fd, data[off:])
            if n == 0:
                raise OSError("write_text: os.write returned 0 (short write)")
            off += n
    finally:
        os.close(fd)


def write_sysfs(path: Path | str, value: str) -> None:
    """Write value (plus trailing newline) to a sysfs attribute path."""
    write_text(Path(path), value if value.endswith("\n") else value + "\n")


def _atomic_write(path: Path, data: bytes) -> None:
    """Write data to path atomically via tempfile + os.replace in same directory. A SIGKILL between mkstemp and os.replace can leave a .r9700-tunerd-* temp file beside the target; harmless, remove by hand."""
    dir_ = path.parent
    mode = 0o644
    if path.is_file():
        mode = path.stat().st_mode & 0o777
    fd, tmp = tempfile.mkstemp(dir=str(dir_), prefix=".r9700-tunerd-")
    try:
        off = 0
        while off < len(data):
            n = os.write(fd, data[off:])
            if n == 0:
                raise OSError("atomic_write: os.write returned 0")
            off += n
        os.fchmod(fd, mode)
        os.close(fd)
        fd = -1
        os.replace(tmp, str(path))
    except BaseException:
        if fd >= 0:
            os.close(fd)
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def norm_hex(value: str) -> str:
    v = value.strip().lower()
    if not v.startswith("0x"):
        v = "0x" + v
    return v


def load_conf(path: Path = CONF_PATH) -> dict[str, str]:
    data = dict(DEFAULTS)
    if path.is_file():
        for raw in path.read_text(encoding="utf-8").splitlines():
            line = raw.split("#", 1)[0].strip()
            if not line or "=" not in line:
                continue
            k, v = line.split("=", 1)
            data[k.strip()] = v.strip()
    return data


def validate_conf(conf: dict[str, str]) -> tuple[dict, list[str]]:
    """Parse and validate a raw string config dict.

    Returns (parsed_dict, problems).
    Fatal problems: bad identity hex, unparsable or out-of-range numbers.
    Non-fatal: unknown keys (reported but not fatal).
    """
    problems: list[str] = []
    parsed: dict = {}

    # Unknown keys — non-fatal
    for k in conf:
        if k not in KNOWN_KEYS:
            problems.append(f"unknown key {k}")

    # Identity hex fields: must match 0xNNNN
    for key in ("VENDOR", "DEVICE", "SUBSYSTEM_VENDOR", "SUBSYSTEM_DEVICE"):
        raw = conf.get(key, "")
        if not raw:
            problems.append(f"{key}: empty value")
            parsed[key] = None
            continue
        v = norm_hex(raw)
        if not _HEX_RE.match(v):
            problems.append(f"{key}={v} does not match 0xNNNN")
            parsed[key] = None
        else:
            parsed[key] = v

    # POWER_LIMIT_W: int 50..1000
    raw = conf.get("POWER_LIMIT_W", "")
    try:
        v = int(raw)
        if v < 50 or v > 1000:
            problems.append(f"POWER_LIMIT_W={v} out of range 50..1000")
            parsed["POWER_LIMIT_W"] = None
        else:
            parsed["POWER_LIMIT_W"] = v
    except (ValueError, TypeError):
        problems.append(f"POWER_LIMIT_W={raw!r} is not a valid integer")
        parsed["POWER_LIMIT_W"] = None

    # VOLTAGE_OFFSET_MV: int -500..0
    raw = conf.get("VOLTAGE_OFFSET_MV", "")
    try:
        v = int(raw)
        if v < -500 or v > 0:
            problems.append(f"VOLTAGE_OFFSET_MV={v} out of range -500..0")
            parsed["VOLTAGE_OFFSET_MV"] = None
        else:
            parsed["VOLTAGE_OFFSET_MV"] = v
    except (ValueError, TypeError):
        problems.append(f"VOLTAGE_OFFSET_MV={raw!r} is not a valid integer")
        parsed["VOLTAGE_OFFSET_MV"] = None

    # POLL_INTERVAL_S: float 1.0..60.0
    raw = conf.get("POLL_INTERVAL_S", "")
    try:
        v = float(raw)
        if v < 1.0 or v > 60.0:
            problems.append(f"POLL_INTERVAL_S={v} out of range 1.0..60.0")
            parsed["POLL_INTERVAL_S"] = None
        else:
            parsed["POLL_INTERVAL_S"] = v
    except (ValueError, TypeError):
        problems.append(f"POLL_INTERVAL_S={raw!r} is not a valid number")
        parsed["POLL_INTERVAL_S"] = None

    # EVICT_GUARD: boolean 0 or 1
    raw = conf.get("EVICT_GUARD", "")
    try:
        v = int(raw)
        if v not in (0, 1):
            problems.append(f"EVICT_GUARD={v} must be 0 or 1")
            parsed["EVICT_GUARD"] = None
        else:
            parsed["EVICT_GUARD"] = bool(v)
    except (ValueError, TypeError):
        problems.append(f"EVICT_GUARD={raw!r} is not a valid boolean (0/1)")
        parsed["EVICT_GUARD"] = None

    # EVICT_GUARD_MARGIN: float, 0.0 < v <= 1.0
    raw = conf.get("EVICT_GUARD_MARGIN", "")
    try:
        v = float(raw)
        if v <= 0.0 or v > 1.0:
            problems.append(f"EVICT_GUARD_MARGIN={v} out of range (0.0, 1.0]")
            parsed["EVICT_GUARD_MARGIN"] = None
        else:
            parsed["EVICT_GUARD_MARGIN"] = v
    except (ValueError, TypeError):
        problems.append(f"EVICT_GUARD_MARGIN={raw!r} is not a valid number")
        parsed["EVICT_GUARD_MARGIN"] = None

    return parsed, problems


# ---------------------------------------------------------------------------
# Evict guard: VRAM-in-use and GTT-total helpers
# ---------------------------------------------------------------------------

PROC_ROOT = Path("/proc")
MEMINFO_PATH = Path("/proc/meminfo")

_gtt_cache: dict[str, int] = {}
_gtt_fallback_warned = False


def _parse_kib(value: str) -> int | None:
    """Parse a drm fdinfo value like '12345 KiB' -> 12345, else None."""
    parts = value.split()
    if not parts:
        return None
    try:
        return int(parts[0])
    except ValueError:
        return None


def drm_vram_in_use(pci_addr: str) -> int:
    """Sum VRAM (bytes) currently in use on pci_addr, via /proc/*/fdinfo.

    Scans every open fd of every process that is a symlink into
    /dev/dri/*, parses the fdinfo key/value block, and keeps the max
    drm-total-vram (or drm-memory-vram fallback) per unique
    drm-client-id to avoid double-counting the same client opened on
    multiple fds. Never opens /dev/dri/* itself.
    """
    clients: dict[str, int] = {}
    try:
        entries = os.listdir(PROC_ROOT)
    except OSError:
        return 0

    for pid in entries:
        if not pid.isdigit():
            continue
        fd_dir = PROC_ROOT / pid / "fd"
        try:
            fds = os.listdir(fd_dir)
        except (PermissionError, FileNotFoundError, ProcessLookupError, OSError):
            continue
        for fd in fds:
            try:
                target = os.readlink(fd_dir / fd)
            except (PermissionError, FileNotFoundError, ProcessLookupError, OSError):
                continue
            if not target.startswith("/dev/dri/"):
                continue

            fdinfo_path = PROC_ROOT / pid / "fdinfo" / fd
            try:
                text = fdinfo_path.read_text(encoding="utf-8", errors="replace")
            except (PermissionError, FileNotFoundError, ProcessLookupError, OSError):
                continue

            pdev = None
            client_id = None
            total_vram_kib = None
            mem_vram_kib = None
            for line in text.splitlines():
                if ":" not in line:
                    continue
                k, _, v = line.partition(":")
                k = k.strip()
                v = v.strip()
                if k == "drm-pdev":
                    pdev = v
                elif k == "drm-client-id":
                    client_id = v
                elif k == "drm-total-vram":
                    total_vram_kib = _parse_kib(v)
                elif k == "drm-memory-vram":
                    mem_vram_kib = _parse_kib(v)

            if pdev != pci_addr or client_id is None:
                continue
            kib = total_vram_kib if total_vram_kib is not None else mem_vram_kib
            if kib is None:
                continue
            if kib > clients.get(client_id, 0):
                clients[client_id] = kib

    return sum(clients.values()) * 1024


def gtt_total_bytes(pci) -> int:
    """Return the GPU's total GTT size in bytes, cached at module level.

    Only ever called (via the caller's contract) while the device is
    runtime-active; this function does not itself check runtime_status.
    Falls back to MemTotal/2 (from /proc/meminfo) if the sysfs file is
    unreadable, logging that fallback once.
    """
    global _gtt_fallback_warned
    key = str(pci)
    if key in _gtt_cache:
        return _gtt_cache[key]

    try:
        val = int(read_text(Path(pci) / "mem_info_gtt_total"))
        _gtt_cache[key] = val
        return val
    except (OSError, ValueError):
        pass

    val = 0
    try:
        for line in MEMINFO_PATH.read_text(encoding="utf-8").splitlines():
            if line.startswith("MemTotal:"):
                mem_total_kb = int(line.split()[1])
                val = (mem_total_kb * 1024) // 2
                break
    except (OSError, ValueError, IndexError):
        val = 0

    if not _gtt_fallback_warned:
        log(f"gtt_total_bytes: {pci} mem_info_gtt_total unreadable, falling back to MemTotal/2", syslog.LOG_WARNING)
        _gtt_fallback_warned = True

    _gtt_cache[key] = val
    return val


def pci_ids(dev: Path) -> tuple[str, str, str, str] | None:
    try:
        return (
            read_text(dev / "vendor").lower(),
            read_text(dev / "device").lower(),
            read_text(dev / "subsystem_vendor").lower(),
            read_text(dev / "subsystem_device").lower(),
        )
    except OSError:
        return None


def discover(conf: dict, *, required: bool = True) -> Path | None:
    """Find the R9700 by PCI identity."""
    want = (
        norm_hex(conf["VENDOR"]),
        norm_hex(conf["DEVICE"]),
        norm_hex(conf["SUBSYSTEM_VENDOR"]),
        norm_hex(conf["SUBSYSTEM_DEVICE"]),
    )
    hits: list[Path] = []
    if not PCI_ROOT.is_dir():
        if required:
            die(f"missing {PCI_ROOT}")
        return None
    for dev in sorted(PCI_ROOT.iterdir()):
        ids = pci_ids(dev)
        if ids == want:
            hits.append(dev)
    if not hits:
        if required:
            die(
                "R9700 not found "
                f"(want {want[0]}:{want[1]} {want[2]}:{want[3]})"
            )
        return None
    if len(hits) > 1:
        if required:
            die("multiple R9700 matches: " + " ".join(d.name for d in hits))
        return None
    return hits[0]


def check_runtime_pm(pci: Path) -> None:
    """Warn once per daemon start if power/control is not 'auto'."""
    global _last_pm_refusal
    try:
        val = read_text(pci / "power" / "control")
    except OSError:
        return
    if val != "auto":
        msg = (
            f"power/control={val}; runtime PM disabled by operator, "
            "watcher will never see suspend"
        )
        log(msg, syslog.LOG_WARNING)
        _last_pm_refusal = msg


def require_runtime_pm(pci: Path) -> None:
    """Refuse to write if power/control is not 'auto'.

    On an APU the display iGPU runs with control=on, so this guard is what
    stops a mistyped identity from tuning the display GPU. When the evict
    guard has intentionally pinned control=on to hold the dGPU awake, that
    condition is expected and the check passes.
    """
    last_err: OSError | None = None
    for attempt in range(3):
        try:
            val = read_text(pci / "power" / "control")
        except OSError as e:
            last_err = e
            if attempt < 2:
                time.sleep(0.1)
            continue
        # Successfully read the value.
        if val != "auto":
            if val == "on" and _evict.holding:
                return  # evict-guard intentionally holding — pass
            raise RuntimeError(
                f"power/control={val}; this tool only writes to "
                "runtime-PM-managed GPUs (control=auto); refusing"
            )
        return  # "auto" → pass
    raise RuntimeError(f"power/control unreadable after retries: {last_err}")


def runtime_status(pci: Path) -> str:
    try:
        return read_text(pci / "power" / "runtime_status").lower()
    except OSError as e:
        return f"unreadable:{e}"


def runtime_suspended_ms(pci: Path) -> int | None:
    """Read power/runtime_suspended_time (accumulated ms in suspend state).

    Safe to read while the device is suspended: the kernel does not wake
    the card to service this sysfs read (verified on target: 20 reads at
    0.5 s intervals, status remained suspended/D3cold).  The value is
    monotonically increasing and increments on every suspend, making it a
    reliable wake signal even when the suspended state is never observed
    by the poll loop (e.g. suspend+resume both occur between two polls).
    """
    try:
        return int(read_text(pci / "power" / "runtime_suspended_time"))
    except (OSError, ValueError):
        return None


def power_state(pci: Path) -> str:
    try:
        return read_text(pci / "power_state")
    except OSError:
        return "unknown"


def is_active(pci: Path) -> bool:
    return runtime_status(pci) == "active"


def drm_names(pci: Path) -> dict[str, str]:
    out: dict[str, str] = {}
    drm = pci / "drm"
    if not drm.is_dir():
        return out
    for child in drm.iterdir():
        name = child.name
        if name.startswith("card") or name.startswith("renderD"):
            out[name] = str(child)
    return out


def hwmon_dir(pci: Path) -> Path | None:
    """Return the hwmonN directory for this GPU.

    Candidates are sorted numerically by N (lexical sort would put hwmon12
    before hwmon7).  After a driver rebind, stale hwmon entries can linger
    without power1_cap; prefer the first (lowest N) candidate that actually
    contains power1_cap, falling back to the first numeric candidate.
    """
    hroot = pci / "hwmon"
    if not hroot.is_dir():
        return None
    candidates: list[tuple[int, Path]] = []
    for child in hroot.iterdir():
        if child.name.startswith("hwmon"):
            suffix = child.name[len("hwmon"):]
            if suffix.isdigit():
                candidates.append((int(suffix), child))
    if not candidates:
        return None
    candidates.sort(key=lambda x: x[0])
    # Prefer first candidate with power1_cap (stale entries after rebind
    # may lack it); fall back to first numeric candidate.
    for _, path in candidates:
        if (path / "power1_cap").is_file():
            return path
    return candidates[0][1]


def parse_od(text: str) -> dict:
    current_mv = None
    min_mv = None
    max_mv = None
    in_offset = False
    in_range = False
    for line in text.splitlines():
        s = line.strip()
        if s.startswith("OD_VDDGFX_OFFSET"):
            in_offset = True
            in_range = False
            # The header line itself may carry a value, e.g.
            # "OD_VDDGFX_OFFSET: -25mV" (one-line form).  Capture it;
            # the two-line form (header then value on next line) still works
            # because the regex simply won't match a bare header.
            m = re.search(r"(-?\d+)\s*mV", s, re.I)
            if m:
                current_mv = int(m.group(1))
            continue
        if s.startswith("OD_RANGE"):
            in_range = True
            in_offset = False
            continue
        if s.startswith("OD_"):
            in_offset = False
            in_range = False
            continue
        if in_offset and s:
            m = re.search(r"(-?\d+)\s*mV", s, re.I)
            if m:
                current_mv = int(m.group(1))
        if in_range and "VDDGFX_OFFSET" in s.upper().replace(" ", ""):
            nums = [int(x) for x in re.findall(r"(-?\d+)\s*mV", s, flags=re.I)]
            if len(nums) >= 2:
                min_mv, max_mv = nums[0], nums[1]
    return {"current_mv": current_mv, "min_mv": min_mv, "max_mv": max_mv, "raw": text}


def read_power_cap(pci: Path) -> dict[str, int]:
    h = hwmon_dir(pci)
    if h is None:
        raise RuntimeError("no hwmon")
    def _r(name: str) -> int:
        return int(read_text(h / name))
    return {
        "cap": _r("power1_cap"),
        "min": _r("power1_cap_min"),
        "max": _r("power1_cap_max"),
        "default": _r("power1_cap_default"),
    }


def write_power_cap(pci: Path, watts: int) -> None:
    h = hwmon_dir(pci)
    if h is None:
        raise RuntimeError("no hwmon")
    write_text(h / "power1_cap", str(int(watts * 1_000_000)) + "\n")


def read_od(pci: Path) -> dict:
    return parse_od(read_text(pci / "pp_od_clk_voltage"))


def write_vo(pci: Path, mv: int) -> None:
    path = pci / "pp_od_clk_voltage"
    write_text(path, f"vo {int(mv)}\n")
    write_text(path, "c\n")


def reset_od(pci: Path) -> None:
    path = pci / "pp_od_clk_voltage"
    write_text(path, "r\n")
    try:
        write_text(path, "c\n")
    except OSError:
        pass


def write_state(payload: str = "", *, state: str | None = None, pci=None,
                 vo=None, vram_used: int | None = None,
                 gtt_total: int | None = None, **extra) -> None:
    """Atomically write state file (best-effort; /run may be absent).

    Two call forms are supported:
      - write_state(raw_payload_string)               — legacy, pre-built text
      - write_state(state=..., pci=..., vo=..., ...)   — builds the payload
        from keyword fields, adding vram_used/gtt_total when given.
    """
    if not payload:
        lines = []
        if pci is not None:
            lines.append(f"pci={pci.name}")
        if state is not None:
            lines.append(f"state={state}")
        if vo is not None:
            lines.append(f"vo={vo}")
        if vram_used is not None:
            lines.append(f"vram_used={vram_used}")
        if gtt_total is not None:
            lines.append(f"gtt_total={gtt_total}")
        for k, v in extra.items():
            lines.append(f"{k}={v}")
        lines.append(f"ts={int(time.time())}")
        payload = "\n".join(lines) + "\n"
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        _atomic_write(STATE_DIR / "state", payload.encode("utf-8"))
    except OSError:
        pass


def save_ranges(cap: dict, od: dict) -> None:
    """Best-effort: persist live cap/OD ranges for offline validation. Never raises."""
    try:
        payload = {
            "cap_min_w": cap["min"] / 1_000_000,
            "cap_max_w": cap["max"] / 1_000_000,
            "cap_default_w": cap["default"] / 1_000_000,
            "vo_min_mv": od["min_mv"],
            "vo_max_mv": od["max_mv"],
            "ts": int(time.time()),
        }
        RANGES_PATH.parent.mkdir(parents=True, exist_ok=True)
        _atomic_write(RANGES_PATH, json.dumps(payload).encode("utf-8"))
    except Exception:
        pass


def load_ranges() -> dict | None:
    """Load cached live ranges. Returns None if missing/invalid/any key None."""
    try:
        data = json.loads(RANGES_PATH.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError, ValueError):
        return None
    if not isinstance(data, dict):
        # Valid JSON that is not an object (null, 42, true): treat as no cache.
        return None
    required = ("cap_min_w", "cap_max_w", "cap_default_w", "vo_min_mv", "vo_max_mv", "ts")
    for k in required:
        if k not in data or data[k] is None:
            return None
    return data


class Transient(RuntimeError):
    """Retryable OD/sysfs glitch during SMU settle."""


def is_transient(exc: BaseException) -> bool:
    if isinstance(exc, Transient):
        return True
    if isinstance(exc, OSError) and exc.errno in TRANSIENT_ERRNO:
        return True
    msg = str(exc).lower()
    return "busy" in msg or "resource busy" in msg


def od_attempts(pci: Path, fn, *, settle: bool = True):
    """Call fn while active. Settle, then retry transient errors. No infinite loop."""
    if settle:
        time.sleep(SETTLE_S)
    last: BaseException | None = None
    sleeps = (0.0,) + RETRY_SLEEPS
    for i, delay in enumerate(sleeps):
        if delay:
            time.sleep(delay)
        if not is_active(pci):
            raise RuntimeError(f"runtime_status={runtime_status(pci)} before OD attempt {i+1}")
        try:
            return fn()
        except Exception as e:  # sysfs errors vary
            last = e
            if not is_transient(e):
                raise
            continue
    assert last is not None
    raise last


def maybe_scan_kernel_fatals() -> None:
    """Scan kernel log for fatal GPU errors. Rate-limited to once per 60 s."""
    global _last_kernel_scan
    now = time.monotonic()
    if now - _last_kernel_scan < 60.0:
        return
    _last_kernel_scan = now
    try:
        r = subprocess.run(
            ["journalctl", "-k", "--no-pager", "-n", "80", "-o", "cat"],
            capture_output=True,
            text=True,
            timeout=2,
        )
    except (OSError, subprocess.TimeoutExpired):
        return
    fatals = []
    for line in r.stdout.splitlines():
        if KERNEL_OD_NOISE.search(line):
            continue
        if KERNEL_FATAL.search(line):
            fatals.append(line)
    if fatals:
        log("kernel warning: " + fatals[-1], syslog.LOG_WARNING)


def restore_voltage(pci: Path, conf: dict) -> tuple[str, dict]:
    """Read-before-write VO restore. One logical apply per call (with bounded retries).

    Returns (status_string, od_dict) where od_dict is the raw read_od result.
    """
    # conf is validated: VOLTAGE_OFFSET_MV is already an int.
    want = conf["VOLTAGE_OFFSET_MV"]

    def _read():
        return read_od(pci)

    od = od_attempts(pci, _read, settle=True)
    # RDNA4/amdgpu: if the driver does not report the OD range we cannot
    # safely write an offset — refuse rather than guess.
    if od["min_mv"] is None or od["max_mv"] is None:
        raise RuntimeError(
            "OD_RANGE for VDDGFX_OFFSET not reported; refusing to write offset"
        )
    if want < od["min_mv"] or want > od["max_mv"]:
        raise RuntimeError(
            f"VOLTAGE_OFFSET_MV={want} outside live range "
            f"{od['min_mv']}..{od['max_mv']} mV"
        )
    if od["current_mv"] == want:
        return f"already {want}", od

    def _write_and_read():
        if not is_active(pci):
            raise RuntimeError("not active before vo write")
        write_vo(pci, want)
        if not is_active(pci):
            raise RuntimeError("not active after vo write")
        got = read_od(pci)["current_mv"]
        if got != want:
            raise Transient(f"readback {got} != {want}")
        return got

    got = od_attempts(pci, _write_and_read, settle=False)
    return f"restored {got}", od


def maybe_restore_cap(pci: Path, conf: dict, *, force_log: bool) -> tuple[str, dict]:
    """Read cap; write only if it does not match config. Never on a guess.

    Returns (status_string, cap_dict) where cap_dict is the raw read_power_cap result.
    """
    # conf is validated: POWER_LIMIT_W is already an int.
    want = conf["POWER_LIMIT_W"]

    def _read():
        return read_power_cap(pci)

    cap = od_attempts(pci, _read, settle=False)
    min_w = cap["min"] / 1_000_000
    max_w = cap["max"] / 1_000_000
    if want < min_w or want > max_w:
        raise RuntimeError(
            f"POWER_LIMIT_W={want} outside live range {min_w:.0f}–{max_w:.0f} W"
        )
    cur_w = cap["cap"] / 1_000_000
    if abs(cur_w - want) < 0.5:
        if force_log:
            log(f"power cap already {cur_w:.0f} W")
        return f"already {cur_w:.0f}", cap

    def _write():
        write_power_cap(pci, want)
        cap2 = read_power_cap(pci)
        return cap2["cap"] / 1_000_000

    got = od_attempts(pci, _write, settle=False)
    log(f"power cap applied: {got:.0f} W")
    return f"applied {got:.0f}", cap


def cmd_discover(conf: dict) -> int:
