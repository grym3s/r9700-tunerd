    return cmd_apply(conf)


def handle_wake(pci: Path, conf: dict, cap_checked: bool) -> bool:
    """Rising-edge handler. Returns new cap_checked flag.

    Exactly one VO restore attempt cycle per wake. Cap is written only if
    missing (startup verify, or readback proves loss after reset).
    """
    global _last_pm_refusal
    log("R9700 runtime active")
    # conf is validated: VOLTAGE_OFFSET_MV is already an int.
    want = conf["VOLTAGE_OFFSET_MV"]

    # Runtime-PM write guard: refuse to write if control != auto.
    try:
        require_runtime_pm(pci)
    except RuntimeError as e:
        msg = str(e)
        if msg != _last_pm_refusal:
            log(msg, syslog.LOG_WARNING)
        _last_pm_refusal = msg
        # Do NOT call restore_voltage or the cap path.
        # Not configured: the offset was NOT written (runtime PM guard refused).
        write_state(f"pci={pci.name}\nstate=ACTIVE_PM_REFUSED\nvo=stock\nts={int(time.time())}\n")
        return cap_checked

    # require_runtime_pm passed — log recovery if we were previously refused.
    if _last_pm_refusal is not None:
        log("runtime PM guard OK again (power/control=auto)")
        _last_pm_refusal = None

    od_data = None
    try:
        result, od_data = restore_voltage(pci, conf)
        if result.startswith("restored"):
            log(f"VDDGFX offset restored: {want} mV")
        # already-correct: no extra log beyond runtime active
    except Exception as e:
        od_data = None
        log(
            f"VDDGFX offset restore failed: {e}; leaving stock voltage",
            syslog.LOG_WARNING,
        )
        maybe_scan_kernel_fatals()
        # Still do a one-time/lost cap check; VO failure must not block the GPU.
    if not is_active(pci):
        return cap_checked
    cap_data = None
    try:
        if not cap_checked:
            _cap_result, cap_data = maybe_restore_cap(pci, conf, force_log=True)
            cap_checked = True
        else:
            # Ordinary BACO: read; write only if the cap was actually lost.
            _cap_result, cap_data = maybe_restore_cap(pci, conf, force_log=False)
    except Exception as e:
        cap_data = None
        log(f"power cap check failed: {e}", syslog.LOG_WARNING)
        if not cap_checked:
            cap_checked = True  # do not hammer
    if od_data is not None and cap_data is not None:
        save_ranges(cap_data, od_data)
    maybe_scan_kernel_fatals()
    write_state(f"pci={pci.name}\nstate=ACTIVE_CONFIGURED\nvo={want}\nts={int(time.time())}\n")
    return cap_checked


def cmd_watch(conf: dict) -> int:
    global _stop

    def _handle(signum, frame):
        global _stop
        _stop = True

    signal.signal(signal.SIGTERM, _handle)
    signal.signal(signal.SIGINT, _handle)

    # conf is the validated dict from main (POLL_INTERVAL_S is a float).
    interval = max(1.0, min(60.0, float(conf.get("POLL_INTERVAL_S", 2.0))))

    pci = discover(conf, required=False)
    if pci is not None:
        check_runtime_pm(pci)
        log(f"R9700 discovered at {pci.name}")
    else:
        log("R9700 not found yet; waiting", syslog.LOG_WARNING)

    state = ST_SUSPENDED
    cap_checked = False
    last_good = conf  # last successfully validated config
    last_warn_text: str | None = None
    last_unknown_warn: str | None = None
    was_present = pci is not None
    susp_at_last_wake: int | None = None
    # Tracks whether the last counter read succeeded (for dedup of the
    # "unreadable" warning: only log when transitioning good→None).
    _susp_prev_ok = False

    # Initial edge: if already active, treat as unconfigured (boot / daemon start).
    if pci is not None and is_active(pci):
        state = ST_ACTIVE_UNCONFIGURED
        cap_checked = handle_wake(pci, last_good, cap_checked)
        state = ST_ACTIVE_CONFIGURED
        # Update baseline with None-safety: never overwrite a good value.
        _new_susp = runtime_suspended_ms(pci)
        if _new_susp is None:
            if _susp_prev_ok:
                log(
                    "runtime_suspended_time unreadable; counter wake detection degraded",
                    syslog.LOG_WARNING,
                )
            _susp_prev_ok = False
        else:
            susp_at_last_wake = _new_susp
            _susp_prev_ok = True
    elif pci is not None:
        state = ST_SUSPENDED

    while not _stop:
        try:
            # Reload config with validation (explicit CONF_PATH to avoid
            # stale default-arg binding).
            raw = load_conf(CONF_PATH)
            parsed, problems = validate_conf(raw)
            fatal = [p for p in problems if not p.startswith("unknown key")]
            if fatal:
                warn_text = "; ".join(problems)
                if warn_text != last_warn_text:
                    log(
                        f"config reload failed, keeping last good: {warn_text}",
                        syslog.LOG_WARNING,
                    )
                    last_warn_text = warn_text
                # keep using last_good
            else:
                if last_warn_text is not None:
                    log("config OK again")
                    last_warn_text = None
                if problems:
                    unknown_text = "; ".join(problems)
                    if unknown_text != last_unknown_warn:
                        log(unknown_text, syslog.LOG_WARNING)
                        last_unknown_warn = unknown_text
                else:
                    last_unknown_warn = None
                last_good = parsed

            conf_now = last_good
            interval = max(1.0, min(60.0, float(conf_now.get("POLL_INTERVAL_S", 2.0))))

            pci = discover(conf_now, required=False)
            if pci is None:
                # Device gone: reset state so next appearance is a wake.
                if was_present:
                    log("R9700 not present", syslog.LOG_WARNING)
                    was_present = False
                state = ST_SUSPENDED
                susp_at_last_wake = None
                _susp_prev_ok = False
                time.sleep(interval)
                continue

            if not was_present:
                log(f"R9700 discovered at {pci.name}")
                was_present = True

            st = runtime_status(pci)
            # Only "active" is a rising edge; only "suspended" is a falling edge.
            # "unreadable:...", "suspending", "resuming" are NOT transitions.
            if st == "active":
                wake_detected = False
                via_counter = False

                if state == ST_SUSPENDED:
                    # Plain edge (suspended→active): no counter read needed.
                    wake_detected = True
                else:
                    # Counter-based detection (only when the edge path did
                    # not already fire, to avoid an extra sysfs read).
                    now_susp = runtime_suspended_ms(pci)
                    # A counter that stops being readable while active means
                    # detection is degraded until it returns; say so once.
                    if now_susp is None:
                        if _susp_prev_ok:
                            log(
                                "runtime_suspended_time unreadable; counter wake detection degraded",
                                syslog.LOG_WARNING,
                            )
                        _susp_prev_ok = False
                    elif not _susp_prev_ok and susp_at_last_wake is not None:
                        _susp_prev_ok = True
                    if (
                        now_susp is not None
                        and susp_at_last_wake is not None
                        and now_susp > susp_at_last_wake
                    ):
                        wake_detected = True
                        via_counter = True
                    elif (
                        now_susp is not None
                        and susp_at_last_wake is not None
                        and now_susp < susp_at_last_wake
                    ):
                        # Driver rebind/reset reset the counter to a lower value.
                        log(
                            f"runtime_suspended_time regressed "
                            f"({susp_at_last_wake}→{now_susp}); driver rebind?",
                            syslog.LOG_WARNING,
                        )
                        wake_detected = True

                if wake_detected:
                    if via_counter:
                        log(
                            "R9700 runtime active (resume detected via "
                            "runtime_suspended_time, suspended sample not observed)"
                        )
                    state = ST_ACTIVE_UNCONFIGURED
                    cap_checked = handle_wake(pci, conf_now, cap_checked)
                    state = ST_ACTIVE_CONFIGURED
                    # Update baseline with None-safety.
                    _new_susp = runtime_suspended_ms(pci)
                    if _new_susp is None:
                        if _susp_prev_ok:
                            log(
                                "runtime_suspended_time unreadable; counter wake detection degraded",
                                syslog.LOG_WARNING,
                            )
                        _susp_prev_ok = False
                    else:
                        susp_at_last_wake = _new_susp
                        _susp_prev_ok = True

                # --- Eviction guard: hold/release power/control ---------
                if conf_now.get("EVICT_GUARD"):
                    vo = conf_now["VOLTAGE_OFFSET_MV"]
                    vram = drm_vram_in_use(pci.name)
                    margin = conf_now["EVICT_GUARD_MARGIN"]
                    gtt = gtt_total_bytes(pci)  # cached after first call

                    if not _evict.holding and vram > margin * gtt:
                        write_sysfs(pci / "power" / "control", "on")
                        _evict.holding = True
                        _evict.last_vram = vram
                        _evict.last_gtt = gtt
                        if not _evict.logged_hold:
                            log(
                                "evict-guard: holding dGPU awake — VRAM "
                                f"{vram/1e9:.1f}G > {margin*100:.0f}% of GTT "
                                f"{gtt/1e9:.1f}G",
                                syslog.LOG_WARNING,
                            )
                            _evict.logged_hold = True
                            _evict.logged_release = False
                        write_state(state="ACTIVE_HELD", pci=pci, vo=vo,
                                    vram_used=vram, gtt_total=gtt)
                    elif _evict.holding and vram < 0.8 * margin * gtt:
                        write_sysfs(pci / "power" / "control", "auto")
                        _evict.holding = False
                        if not _evict.logged_release:
                            log(
                                "evict-guard: released hold — VRAM "
                                f"{vram/1e9:.1f}G < {0.8*margin*100:.0f}% of "
                                f"GTT {gtt/1e9:.1f}G"
                            )
                            _evict.logged_release = True
                            _evict.logged_hold = False
                        write_state(state="ACTIVE_CONFIGURED", pci=pci, vo=vo)
            elif st == "suspended":
                if state != ST_SUSPENDED:
                    log("R9700 runtime suspended")
                    state = ST_SUSPENDED
                    write_state(f"pci={pci.name}\nstate=SUSPENDED\nts={int(time.time())}\n")
            # else: transitional/unreadable — just sleep and poll again
        except Exception as e:
            log(f"watcher loop error: {e}", syslog.LOG_WARNING)
            # Reset so a failure inside the wake path cannot leave the
            # machine stuck in ACTIVE_UNCONFIGURED; the next active poll
            # re-applies once via the edge path.
            state = ST_SUSPENDED
        time.sleep(interval)

    log("watcher stopping")
    return 0


def cmd_probe_poll(conf: dict, seconds: int = 30) -> int:
    pci = discover(conf)
    assert pci is not None
    interval = max(1.0, min(60.0, float(conf.get("POLL_INTERVAL_S", 2.0))))
    log(f"R9700 discovered at {pci.name}")
    log(f"probe-poll: reading runtime_status every {interval:.0f}s for {seconds}s")
    t0 = time.time()
    samples = []
    while time.time() - t0 < seconds and not _stop:
        samples.append((runtime_status(pci), power_state(pci)))
        time.sleep(interval)
    unique = sorted(set(samples))
    print(f"samples={len(samples)}")
    print("unique=" + ",".join(f"{a}/{b}" for a, b in unique))
    started = samples[0][0] if samples else "?"
    if started != "active" and any(a == "active" for a, _ in samples):
        log("PROBE FAIL: runtime_status became active during poll", syslog.LOG_ERR)
        return 1
    log(f"probe-poll ok: started={started} unique={unique} (poll did not wake)")
    return 0


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="r9700-tunerd")
    p.add_argument("-c", "--config", default=str(CONF_PATH))
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("discover")
    sub.add_parser("status")
    sub.add_parser("apply")
    sub.add_parser("watch")
    sub.add_parser("reset")
    su = sub.add_parser("set-undervolt")
    su.add_argument("mv", type=int, help="VDDGFX offset in mV, e.g. -25")
    spc = sub.add_parser("set-power-cap")
    spc.add_argument("watts", type=int, help="Power cap in watts, e.g. 250")
    sp = sub.add_parser("probe-poll")
    sp.add_argument("--seconds", type=int, default=30)
    return p


def main(argv: list[str] | None = None) -> int:
    syslog.openlog(SYSLOG_IDENT, syslog.LOG_PID, syslog.LOG_DAEMON)
    args = build_parser().parse_args(argv)
    conf_path = Path(args.config)
    global CONF_PATH
    CONF_PATH = conf_path
    raw_conf = load_conf(conf_path)

    # Typed validation: fatal problems abort; unknown keys only warn.
    conf, problems = validate_conf(raw_conf)
    fatal = [p for p in problems if not p.startswith("unknown key")]
    if fatal:
        die("; ".join(problems))
    if problems:
        log("; ".join(problems), syslog.LOG_WARNING)

    if args.cmd == "discover":
        return cmd_discover(conf)
    if args.cmd == "status":
        return cmd_status(conf)
    if args.cmd == "apply":
        return cmd_apply(conf)
    if args.cmd == "watch":
        return cmd_watch(conf)
    if args.cmd == "reset":
        return cmd_reset(conf)
    if args.cmd == "set-undervolt":
        return cmd_set_undervolt(conf, args.mv)
    if args.cmd == "set-power-cap":
        return cmd_set_power_cap(conf, args.watts)
    if args.cmd == "probe-poll":
        return cmd_probe_poll(conf, seconds=args.seconds)
    return 2


if __name__ == "__main__":
    sys.exit(main())
