RANGES_PATH = STATE_DIR / "ranges.json"
PCI_ROOT = Path("/sys/bus/pci/devices")
SYSLOG_IDENT = "r9700-tunerd"


class _EvictGuardState:
    """Module-level runtime state for the VRAM-eviction guard."""
    holding = False       # True when we've written "on" to power/control
    last_vram = 0         # last measured VRAM bytes
    last_gtt = 0          # cached GTT total bytes
    logged_hold = False   # True after first hold log (don't spam)
    logged_release = False


_evict = _EvictGuardState()

