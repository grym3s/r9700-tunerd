#!/usr/bin/python3
"""r9700-tunerd — runtime-PM-aware sysfs tuner for ASUS Radeon AI PRO R9700.

Never opens /dev/dri/card* or renderD*. Never invokes ROCm.
Checks power/runtime_status before every sensor/OD/cap access.

Watcher (Class C): on suspended -> active, restore VOLTAGE_OFFSET_MV only.
Power cap is not rewritten on ordinary BACO resume.
Also detects resume via power/runtime_suspended_time (monotonic counter)
when the suspended state was never sampled between polls.
"""
from __future__ import annotations

