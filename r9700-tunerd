def apply_explicit(conf: dict, *, reason: str) -> str:
    """Explicit apply: power cap then VO. Not used on ordinary BACO resume."""
    pci = discover(conf)
    assert pci is not None
    if not is_active(pci):
        return f"skip status={runtime_status(pci)}"
    # Runtime-PM write guard: refuse before any sysfs write.
    try:
        require_runtime_pm(pci)
    except RuntimeError as e:
        try:
            val = read_text(pci / "power" / "control")
        except OSError:
            val = "unreadable"
        return f"skip control={val}"
    cap_s, cap_data = maybe_restore_cap(pci, conf, force_log=True)
    vo_s, od_data = restore_voltage(pci, conf)
    save_ranges(cap_data, od_data)
    if vo_s.startswith("restored"):
        mv = conf["VOLTAGE_OFFSET_MV"]
        log(f"VDDGFX offset applied: {mv} mV")
    elif vo_s.startswith("already"):
        log(f"VDDGFX offset already {conf['VOLTAGE_OFFSET_MV']} mV")
    write_state(f"pci={pci.name}\nreason={reason}\n{cap_s}\n{vo_s}\nts={int(time.time())}\n")
    return f"ok {cap_s} {vo_s}"


def cmd_apply(conf: dict) -> int:
    try:
        pci = discover(conf)
        assert pci is not None
        log(f"R9700 discovered at {pci.name}")
        summary = apply_explicit(conf, reason="apply")
        if summary.startswith("skip"):
            log(f"apply skipped: {summary}")
            return 0
        log(summary)
        return 0
    except Exception as e:
        log(f"apply failed: {e}", syslog.LOG_ERR)
        return 1


def cmd_reset(conf: dict) -> int:
    pci = discover(conf)
    assert pci is not None
    if not is_active(pci):
        log(f"reset skipped: runtime_status={runtime_status(pci)}")
        return 0
    # Runtime-PM write guard: refuse before any sysfs write.
    try:
        require_runtime_pm(pci)
    except RuntimeError as e:
        log(f"reset refused: {e}", syslog.LOG_ERR)
        return 1
    try:
        cap = read_power_cap(pci)
        default_w = int(round(cap["default"] / 1_000_000))
        write_power_cap(pci, default_w)
        log(f"power cap restored: {default_w} W")
    except Exception as e:
        log(f"power cap reset failed: {e}", syslog.LOG_ERR)
    try:
        reset_od(pci)
        od = read_od(pci)
        log(f"VDDGFX offset reset: {od['current_mv']} mV")
    except Exception as e:
        log(f"OD reset failed: {e}", syslog.LOG_ERR)
    return 0


def set_conf_value(path: Path, key: str, value: str) -> None:
    """Atomically update one key in the config file."""
    text = path.read_text(encoding="utf-8") if path.is_file() else ""
    pat = re.compile(rf"^{re.escape(key)}=.*$", re.M)
    line = f"{key}={value}"
    if pat.search(text):
        text = pat.sub(line, text)
    else:
        if text and not text.endswith("\n"):
            text += "\n"
        text += line + "\n"
    _atomic_write(path, text.encode("utf-8"))


def cmd_set_undervolt(conf: dict, mv: int) -> int:
    if mv > 0:
        die("VDDGFX offset must be <= 0 mV")
    pci = discover(conf)
    assert pci is not None
    if is_active(pci):
        od = read_od(pci)
        if od["min_mv"] is not None and mv < od["min_mv"]:
            die(f"{mv} mV below live min {od['min_mv']} mV")
        if od["max_mv"] is not None and mv > od["max_mv"]:
            die(f"{mv} mV above live max {od['max_mv']} mV")
        if od["min_mv"] is not None and od["max_mv"] is not None:
            cap = read_power_cap(pci)
            save_ranges(cap, od)
        log(f"set-undervolt: validated against live OD range {od['min_mv']}..{od['max_mv']} mV")
    else:
        cached = load_ranges()
        if cached is None:
            die("card is suspended and no cached range is available; run a workload once so the watcher can record the live range, then retry")
        if mv < cached["vo_min_mv"]:
            die(f"{mv} mV below cached min {cached['vo_min_mv']} mV")
        if mv > cached["vo_max_mv"]:
            die(f"{mv} mV above cached max {cached['vo_max_mv']} mV")
        log(f"set-undervolt: validated against cached OD range {cached['vo_min_mv']}..{cached['vo_max_mv']} mV")
    # Runtime-PM write guard: die before touching the config file.
    try:
        require_runtime_pm(pci)
    except RuntimeError as e:
        die(str(e))
    set_conf_value(CONF_PATH, "VOLTAGE_OFFSET_MV", str(mv))
    log(f"config VOLTAGE_OFFSET_MV={mv}")
    conf["VOLTAGE_OFFSET_MV"] = mv  # keep validated-dict type (int)
    return cmd_apply(conf)


def cmd_set_power_cap(conf: dict, watts: int) -> int:
    """Set POWER_LIMIT_W in config and apply. Mirrors cmd_set_undervolt."""
    pci = discover(conf)
