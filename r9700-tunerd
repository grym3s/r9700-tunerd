        min_w = cap["min"] / 1_000_000
        max_w = cap["max"] / 1_000_000
        if watts < min_w or watts > max_w:
            die(f"{watts} W outside live range {min_w:.0f}..{max_w:.0f} W")
        od = read_od(pci)
        if od["min_mv"] is not None and od["max_mv"] is not None:
            save_ranges(cap, od)
