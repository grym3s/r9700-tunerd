    "EVICT_GUARD_MARGIN": "0.90",
}

KNOWN_KEYS = frozenset(DEFAULTS.keys())

SETTLE_S = 0.35
RETRY_SLEEPS = (0.25, 0.5, 1.0)  # after first try: 4 attempts total
TRANSIENT_ERRNO = {
